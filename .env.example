# ==========================================
# PARKZ ENVIRONMENT CONFIGURATION
# ==========================================

# Database
# Default is SQLite for instant local zero-setup running.
# To connect to PostgreSQL, use: postgresql://postgres:postgres@localhost:5432/parkz
DATABASE_URL=sqlite:///./parkz.db

# JWT Auth & Security
JWT_SECRET=parkz_super_secret_jwt_key_development_2026_secure_hash_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Payment Gateway (Mock mode default for development)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Commission & Cancellation Rules
PLATFORM_COMMISSION_RATE=0.20
CANCELLATION_FULL_REFUND_HOURS=2.0
PARTIAL_REFUND_RATE=0.50

# Maps & AI Assistant
MAP_PROVIDER=google
GOOGLE_MAPS_API_KEY=
FRONTEND_URL=http://localhost:5173
